CLANG ?= clang
BPFTOOL ?= bpftool

TARGET_ARCH ?= x86
BPF_CFLAGS := -O2 -g -Wall -Wextra -Werror -Wno-missing-declarations -target bpf \
	-D__TARGET_ARCH_$(TARGET_ARCH) -I.

BPF_SRC := congestion_control.bpf.c
BPF_OBJ := cubic_tmult.bpf.o
VMLINUX := vmlinux.h

.PHONY: all clean load unload verify

all: $(BPF_OBJ)

$(VMLINUX):
	$(BPFTOOL) btf dump file /sys/kernel/btf/vmlinux format c > $@

$(BPF_OBJ): $(BPF_SRC) congestion_control.h congestion_helpers.h $(VMLINUX)
	$(CLANG) $(BPF_CFLAGS) -c $(BPF_SRC) -o $(BPF_OBJ)

load: $(BPF_OBJ)
	-sudo $(BPFTOOL) struct_ops unregister name cubic_tmult_ops 2>/dev/null
	sudo $(BPFTOOL) struct_ops register $(BPF_OBJ)
	@echo "available: $$(cat /proc/sys/net/ipv4/tcp_available_congestion_control)"

unload:
	sudo $(BPFTOOL) struct_ops unregister name cubic_tmult_ops

verify:
	@echo "kernel: $$(uname -r)"
	@echo "available: $$(cat /proc/sys/net/ipv4/tcp_available_congestion_control)"
	@$(BPFTOOL) struct_ops show

clean:
	rm -f $(BPF_OBJ) $(VMLINUX)
