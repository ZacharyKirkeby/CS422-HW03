CLANG   ?= clang
BPFTOOL ?= bpftool
ARCH    := $(shell uname -m | sed 's/x86_64/x86/' | sed 's/aarch64/arm64/')

INCLUDES := includes
MODULE   := module

CFLAGS_BPF  := -g -O2 -target bpf -D__TARGET_ARCH_$(ARCH) -I$(INCLUDES) \
               -Wall -Wno-unused-value -Wno-pointer-sign
LDLIBS_USER := -lbpf -lelf -lz

PIN_PATH := /sys/fs/bpf/mycc_link

.PHONY: all clean load unload verify

all: $(INCLUDES)/vmlinux.h congestion_control_bpf.o congestion_control_loader

$(INCLUDES)/vmlinux.h:
	$(BPFTOOL) btf dump file /sys/kernel/btf/vmlinux format c > $(INCLUDES)/vmlinux.h

congestion_control_bpf.o: $(MODULE)/congestion_control.bpf.c \
                           $(INCLUDES)/congestion_control.bpf.h \
                           $(INCLUDES)/vmlinux.h
	$(CLANG) $(CFLAGS_BPF) -c $(MODULE)/congestion_control.bpf.c -o congestion_control_bpf.o

congestion_control_loader: $(MODULE)/congestion_control_loader.c \
                            $(INCLUDES)/congestion_control_loader.h
	$(CC) -g -O2 -Wall -I$(INCLUDES) $(MODULE)/congestion_control_loader.c \
		-o congestion_control_loader $(LDLIBS_USER)

load: all
	sudo ./congestion_control_loader

verify:
	sysctl net.ipv4.tcp_available_congestion_control

unload:
	sudo rm -f $(PIN_PATH)

clean: unload
	rm -f $(INCLUDES)/vmlinux.h congestion_control_bpf.o congestion_control_loader